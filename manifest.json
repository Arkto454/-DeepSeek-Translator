{
  "manifest_version": 3,
  "name": "知译 · DeepSeek Translator",
  "version": "0.1.3",
  "description": "翻译当前可见的网页正文、导航和控件文字，支持悬浮球控制。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "知译 · 翻译当前页面"
  },
  "options_page": "dashboard.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
